# Python virtual environment
backend/venv/

# Environment variables
backend/.env
.env

# ChromaDB local data
backend/data/chroma_db/

# Python cache
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.eggs/

# Node modules
frontend/node_modules/
node_modules/

# Next.js build output and generated files
frontend/.next/
frontend/out/
frontend/next-env.d.ts
frontend/tsconfig.tsbuildinfo

# SQLite database
backend/data/*.db
backend/data/*.sqlite

# Personal profiles: real user data, never committed. Use profile.template.json as a starting point.
backend/data/profile.json
backend/data/profiles/

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo

# Logs
*.log
npm-debug.log*

# AI tool configs — machine-specific, not project-wide
.cursor/
.cursorrules
.windsurfrules
.opencode.json
GEMINI.md
.code-review-graph/

# Claude Code — personal, not shared
.claude/settings.local.json
CLAUDE.local.md

# Evals: run outputs and DeepEval caches (evals/.env is covered by .env above)
evals/results/
.deepeval/
.deepeval-cache.json
.pytest_cache/

# Documentation is tracked, including on checkouts with an old local docs/ exclude.
!docs/
!docs/**
# Keep local secrets and scratch output private.
.env.*
!.env.example
!**/.env.example
docs/**/.env*
docs/**/secrets/
docs/**/scratch/
docs/**/*.scratch.*
docs/**/*.pem
docs/**/*.key
docs/**/*.p12
docs/**/*.log
docs/**/*.local.*

docs/**/.DS_Store
