# Required
ANTHROPIC_API_KEY=

# Optional — deployment
# Path to directory containing chroma_db/, posts.db, hierarchy.db, profile.json.
# Defaults to ./data (relative to the backend directory) when not set.
# On Railway: set to /data and mount the persistent volume at /data.
DATA_DIR=

# Exact origin of your deployed frontend, e.g. https://contendo.vercel.app
# Adds this origin to the CORS allow-list in addition to localhost:3000 and *.vercel.app.
FRONTEND_ORIGIN=

# Set to "production" in deployed environments. It never relaxes a check: auth is
# strict in every environment, including when this is unset.
ENVIRONMENT=development

# Supabase JWT secret — used for HS256 token verification.
# Get this from your Supabase project settings → Configuration → API.
SUPABASE_JWT_SECRET=

# Comma-separated Supabase user IDs (the UUID in Authentication → Users) allowed to
# call the admin routes. Empty means nobody is an admin.
ADMIN_USER_IDS=

# LOCAL DEVELOPMENT ONLY. Leave both unset on any deployed server.
# ALLOW_DEV_AUTH=1 lets requests without a valid token act as the user "default".
# The server refuses to start if it is set together with ENVIRONMENT=production.
# ALLOW_DEV_AUTH=1
# ALLOW_LOCAL_PATH_INGEST=1 enables the Obsidian routes that read a folder path on
# the machine running the backend (/obsidian/preview, /obsidian/ingest).
# ALLOW_LOCAL_PATH_INGEST=1

# Supadata API key — required for POST /fetch-youtube-transcript.
# Sign up at supadata.ai and add the key to Railway environment variables.
# Without this, the endpoint returns HTTP 503.
SUPADATA_API_KEY=
# Pipeline variant: A (default), B or C. Leave empty in production until the ablation decision.
PIPELINE_VARIANT=
