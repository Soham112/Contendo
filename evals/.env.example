# Copy to evals/.env (gitignored) and fill in. Only the keys below are allowed;
# any other key (for example an unprefixed SUPABASE_URL) is refused.

# The eval project (contendo-dev). Never the production project.
EVAL_SUPABASE_URL=https://<your-project-ref>.supabase.co
EVAL_SUPABASE_SERVICE_ROLE_KEY=
ANTHROPIC_API_KEY=

# The ref in EVAL_SUPABASE_URL (Project Settings > General > Reference ID).
# Evals refuse to run unless the URL host is exactly <ref>.supabase.co.
EXPECTED_PROJECT_REF=<your-project-ref>

# Optional. Defaults: WARNING, and a dummy JWT secret (the pipeline never verifies JWTs).
# LOG_LEVEL=WARNING
# SUPABASE_JWT_SECRET=
